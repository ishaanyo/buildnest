generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
  orders    Order[]
}

model Theme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  prompt      String   // AI prompt for this theme
  thumbnail   String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  projects    Project[]
}

model Material {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  category    String   // flooring, paint, furniture, lighting, textiles, etc.
  unit        String   // sqm, liter, piece, set
  unitPrice   Float
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Project {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  themeId         String?
  theme           Theme?   @relation(fields: [themeId], references: [id])
  sourceImageUrl  String
  resultImageUrls String[] // array of generated render URLs
  status          ProjectStatus @default(PENDING)
  materialCost    Float?
  laborCost       Float?
  totalCost       Float?
  materialBreakdown Json?  // [{materialId, qty, unitPrice, total}]
  roomType        String?  // bedroom, living, kitchen, bathroom, plot
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
}

enum ProjectStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])
  status        OrderStatus @default(PENDING)
  materialTotal Float
  laborTotal    Float
  packageTotal  Float
  includeLabor  Boolean     @default(true)
  shippingAddress Json?
  paymentStatus String?     // pending, paid, failed
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Float
  unitPrice  Float
  total      Float
}
