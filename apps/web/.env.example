# Neon Postgres
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AICredits — https://aicredits.in
AICREDITS_API_KEY="sk-live-..."
AICREDITS_BASE_URL="https://api.aicredits.in/v1"

# Image generation model (Images API)
# Options: black-forest-labs/flux-1.1-pro | black-forest-labs/flux-2-pro | dall-e-3 | openai/gpt-image-1
AICREDITS_IMAGE_MODEL="black-forest-labs/flux-1.1-pro"

# Photo-conditioned redesign (Chat API image-output models)
# Options: google/gemini-2.5-flash-image | google/gemini-3.1-flash-image
AICREDITS_EDIT_MODEL="google/gemini-2.5-flash-image"

# Vision model for room analysis + cost/labor
# Options: openai/gpt-4o-mini | google/gemini-2.0-flash | anthropic/claude-haiku-4.5
AICREDITS_VISION_MODEL="openai/gpt-4o-mini"

# Optional blob storage
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
